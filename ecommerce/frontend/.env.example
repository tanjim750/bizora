# Empty = use the built-in mock backend. Set to the real API base to switch, e.g. https://api.example.com/v1
API_BASE_URL=
# Absolute site URL for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Delay (ms) of the mock backend so loading states are visible
MOCK_LATENCY_MS=250
# Only if the real API serves images from another host, e.g. cdn.example.com
IMAGE_REMOTE_HOST=
