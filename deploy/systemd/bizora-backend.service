[Unit]
Description=Bizora Django backend
Wants=bizora-postgresql.service
After=bizora-postgresql.service

[Service]
Type=simple
WorkingDirectory=%h/bizora
EnvironmentFile=%h/.config/bizora/backend.env
ExecStart=%h/bizora/.venv/bin/gunicorn --bind 127.0.0.1:18181 --workers 2 --access-logfile - bizora.wsgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
