# ==============================================================================
# BIZORA — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your credentials
# ==============================================================================

# --- Django Core Configuration ---
DEBUG=False
SECRET_KEY=
DJANGO_SETTINGS_MODULE=bizora.settings
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Option 1: Supabase / PostgreSQL Connection URI ---
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Copy the connection string from Supabase Connect; encode special password characters.
# DATABASE_URL selects PostgreSQL unless BIZORA_DATABASE=sqlite is explicitly set.

# --- Option 2: Individual Parameters (Alternative) ---
# BIZORA_DATABASE=postgresql
# POSTGRES_HOST=db.[YOUR-PROJECT-REF].supabase.co
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=[YOUR-PASSWORD]
# POSTGRES_SSLMODE=require

# --- Application Localization ---
TIME_ZONE=UTC
BUSINESS_TIMEZONE=Asia/Dhaka
