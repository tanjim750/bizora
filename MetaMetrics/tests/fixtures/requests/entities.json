{
  "description": "Golden Meta API requests produced by the entity services. Ported from the PHP suite so that both implementations are checked against the same contract.",
  "account": {
    "get": {
      "method": "GET",
      "path": "/v26.0/act_4274485329463051",
      "query": {
        "fields": "id,name,account_id,account_status,currency,timezone_name"
      },
      "encoded_query": "fields=id%2Cname%2Caccount_id%2Caccount_status%2Ccurrency%2Ctimezone_name"
    },
    "get_currency": {
      "method": "GET",
      "path": "/v26.0/act_4274485329463051",
      "query": {
        "fields": "currency"
      },
      "encoded_query": "fields=currency"
    }
  },
  "campaign": {
    "all": {
      "method": "GET",
      "path": "/v23.0/act_123456789/campaigns",
      "query": {
        "fields": "id,name,status,configured_status,effective_status,objective,created_time,updated_time"
      },
      "encoded_query": "fields=id%2Cname%2Cstatus%2Cconfigured_status%2Ceffective_status%2Cobjective%2Ccreated_time%2Cupdated_time"
    },
    "all_filtered": {
      "method": "GET",
      "path": "/v23.0/act_123456789/campaigns",
      "query": {
        "fields": "id,name",
        "effective_status": "[\"ACTIVE\",\"PAUSED\"]",
        "is_completed": true,
        "limit": 50
      },
      "encoded_query": "fields=id%2Cname&effective_status=%5B%22ACTIVE%22%2C%22PAUSED%22%5D&is_completed=1&limit=50"
    },
    "find": {
      "method": "GET",
      "path": "/v23.0/1200000000000001",
      "query": {
        "fields": "id,name,status,configured_status,effective_status,objective,created_time,updated_time"
      },
      "encoded_query": "fields=id%2Cname%2Cstatus%2Cconfigured_status%2Ceffective_status%2Cobjective%2Ccreated_time%2Cupdated_time"
    }
  },
  "ad_set": {
    "all": {
      "method": "GET",
      "path": "/v23.0/act_123456789/adsets",
      "query": {
        "fields": "id,name,campaign_id,status,configured_status,effective_status,optimization_goal,billing_event,daily_budget,lifetime_budget,created_time,updated_time,start_time,end_time"
      },
      "encoded_query": "fields=id%2Cname%2Ccampaign_id%2Cstatus%2Cconfigured_status%2Ceffective_status%2Coptimization_goal%2Cbilling_event%2Cdaily_budget%2Clifetime_budget%2Ccreated_time%2Cupdated_time%2Cstart_time%2Cend_time"
    },
    "for_campaign": {
      "method": "GET",
      "path": "/v23.0/1200000000000001/adsets",
      "query": {
        "fields": "id,name,campaign_id"
      },
      "encoded_query": "fields=id%2Cname%2Ccampaign_id"
