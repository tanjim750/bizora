      "method": "GET",
      "path": "/v23.0/act_123456789/ads",
      "query": {
        "fields": "id,name,adset_id,campaign_id,status,configured_status,effective_status,created_time,updated_time"
      },
      "encoded_query": "fields=id%2Cname%2Cadset_id%2Ccampaign_id%2Cstatus%2Cconfigured_status%2Ceffective_status%2Ccreated_time%2Cupdated_time"
    },
    "for_ad_set": {
      "method": "GET",
      "path": "/v23.0/1200000000000002/ads",
